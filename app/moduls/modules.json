{
  "modules": {
    "sphere_generator": {
      "display_name": "Sphere Generator",
      "description": "Creates simple sphere models with customizable radius",
      "icon": "🌐",
      "functions": {
        "make_sphere": {
          "display_name": "Simple Sphere",
          "description": "Creates a solid sphere",
          "parameters": {
            "radius": {
              "type": "number",
              "default": 10.0,
              "min": 0.1,
              "step": 0.1,
              "label": "Radius (mm)",
              "help": "Radius of the sphere"
            }
          }
        },
        "make_hollow_sphere": {
          "display_name": "Hollow Sphere",
          "description": "Creates a hollow sphere with wall thickness",
          "parameters": {
            "radius": {
              "type": "number",
              "default": 10.0,
              "min": 0.1,
              "step": 0.1,
              "label": "Radius (mm)",
              "help": "Outer radius of the sphere"
            },
            "wall_thickness": {
              "type": "number",
              "default": 2.0,
              "min": 0.1,
              "step": 0.1,
              "label": "Wall Thickness (mm)",
              "help": "Thickness of the sphere wall"
            }
          }
        }
      }
    },
